# Copy to .env and fill in. Never commit .env.
# All values are for PayPal SANDBOX only; NEXTPAY refuses any other PayPal host.

APP_ENV=development            # set to "production" when deployed

# --- URLs -------------------------------------------------------------------
# Public URL of this API (PayPal redirects the buyer here).
BACKEND_URL=http://127.0.0.1:8000
# Public URL of the React app (the API redirects the buyer back here).
FRONTEND_URL=http://localhost:5173
# Optional overrides. Defaults: <BACKEND_URL>/api/paypal/return and /cancel.
# PAYPAL_RETURN_URL=
# PAYPAL_CANCEL_URL=
# Optional comma-separated browser origins allowed by CORS. Default: FRONTEND_URL.
# CORS_ORIGINS=http://localhost:5173

# --- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///./nextpay.db

# --- PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- AI (https://openrouter.ai/keys, free models only) ----------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Payment recovery -------------------------------------------------------
# Seconds a "capturing" claim is treated as in progress before another
# callback may take it over and reconcile with PayPal.
CAPTURE_LEASE_SECONDS=60
